		setValorPorPosicaoX = function(posX)
			local largura = math.max(track.AbsoluteSize.X, 1)
			local rel = math.clamp((posX - track.AbsolutePosition.X) / largura, 0, 1)
			setValor(minVal + rel * (maxVal - minVal), true)
		end
	}
end

