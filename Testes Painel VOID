local function garantirNomesEVidaOutrosJogadores(agora)
	if agora and (agora - ultimoVisibilidadeOutrosTick) < 0.6 then
		return
	end
	ultimoVisibilidadeOutrosTick = agora or os.clock()

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					pcall(function()
						if hum.NameDisplayDistance == Enum.HumanoidDisplayDistanceType.None then
							hum.NameDisplayDistance = Enum.HumanoidDisplayDistanceType.Standard
						end
						if hum.HealthDisplayDistance == Enum.HumanoidDisplayDistanceType.None then
							hum.HealthDisplayDistance = Enum.HumanoidDisplayDistanceType.DisplayWhenDamaged
						end
					end)
				end
				for _, desc in ipairs(char:GetChildren()) do
					if desc:IsA("BillboardGui") and desc.Name ~= "AMG_Focus_Indicator" then
						pcall(function()
							if not desc.Enabled then
								desc.Enabled = true
							end
						end)
					end
				end
			end
		end
	end
end

