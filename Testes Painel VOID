-- ==========================================
-- PVP FOCUS LOOP
-- ==========================================
local function obterRaioHitRegistro()
	local raio = DISTANCIA_MAXIMA + 10
	if hitboxAtivo then
		raio = math.max(raio, hitboxSize + 14)
	end
	return raio
end

local function registrarAlvoPvpPorHit()
	if not pvpFocusLoopAtivo then return nil end
	local _, meuRoot = getCharAndRoot(LocalPlayer)
	if not meuRoot then return nil end

	if alvoPvpLoopPlayer and alvoPvpLoopPlayer.Parent == Players and jogadorElegivelComoAlvo(alvoPvpLoopPlayer) then
		local _, rAtual, humAtual = getCharAndRoot(alvoPvpLoopPlayer)
		if rAtual and humAtual and humAtual.Health > 0 then
			return alvoPvpLoopPlayer
		end
		alvoPvpLoopPlayer = nil
	end

	local raioHit = obterRaioHitRegistro()
	local lookPlano = Vector3.new(meuRoot.CFrame.LookVector.X, 0, meuRoot.CFrame.LookVector.Z)
	if lookPlano.Magnitude > 0.001 then
		lookPlano = lookPlano.Unit
	else
		lookPlano = Vector3.zero
	end

	local melhorPlr = nil
	local melhorScore = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if jogadorElegivelComoAlvo(plr) then
			local _, r, hum = getCharAndRoot(plr)
			if r and hum and hum.Health > 0 then
				local delta = r.Position - meuRoot.Position
				local dist = delta.Magnitude
				if dist <= raioHit and dist > 0.1 then
					local penalidadeAngulo = 0
					if lookPlano.Magnitude > 0.1 then
						local dirPlano = Vector3.new(delta.X, 0, delta.Z)
						if dirPlano.Magnitude > 0.01 then
							local dot = lookPlano:Dot(dirPlano.Unit)
							if dot < 0.05 then
								penalidadeAngulo = (0.05 - dot) * 14
							end
						end
					end
					local score = dist + penalidadeAngulo
					if score < melhorScore then
						melhorScore = score
						melhorPlr = plr
					end
				end
			end
		end
	end

	if melhorPlr then
		alvoPvpLoopPlayer = melhorPlr
		janelaRegistroHitAte = 0
		if sincronizarHitboxEMarcadores then
			pcall(sincronizarHitboxEMarcadores)
		end
	end

	return melhorPlr
end

local function obterAlvoPvpLoopRegistrado(meuRoot)
	if not pvpFocusLoopAtivo or not meuRoot then
		alvoPvpLoopPlayer = nil
		return nil, nil, false
	end

	if not (alvoPvpLoopPlayer and alvoPvpLoopPlayer.Parent == Players and jogadorElegivelComoAlvo(alvoPvpLoopPlayer)) then
		alvoPvpLoopPlayer = nil
		return nil, nil, false
	end

	local _, rAtual, humAtual = getCharAndRoot(alvoPvpLoopPlayer)
	if not (rAtual and humAtual and humAtual.Health > 0) then
		alvoPvpLoopPlayer = nil
		if sincronizarHitboxEMarcadores then
			pcall(sincronizarHitboxEMarcadores)
		end
		return nil, nil, false
	end

	local raioBase = obterRaioHitRegistro()
	local distAtual = (rAtual.Position - meuRoot.Position).Magnitude
	local margemExtra = hitboxAtivo and (hitboxSize * 0.5) or 0
	local dentroDoAlcance = (distAtual <= (raioBase + margemExtra) and distAtual > 0.1)
	return rAtual, alvoPvpLoopPlayer, dentroDoAlcance
end

-- ==========================================
-- DESVIO QUANDO AMIGO ESTA NA FRENTE
-- ==========================================
local function desviarMiraSeAmigoNaFrente(meuRoot)
	if not meuRoot then return end
	if invisivelAtivo then return end
	if ativo and targetLockHabilitadoNoPainel then return end
	if UserInputService:GetFocusedTextBox() then return end

	local lookPlano = Vector3.new(meuRoot.CFrame.LookVector.X, 0, meuRoot.CFrame.LookVector.Z)
	if lookPlano.Magnitude < 0.001 then return end
	lookPlano = lookPlano.Unit

	local amigoBloqueando = false
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and ehAmigoAMG(plr) then
			local _, rAmigo = getCharAndRoot(plr)
			if rAmigo then
				local delta = Vector3.new(rAmigo.Position.X - meuRoot.Position.X, 0, rAmigo.Position.Z - meuRoot.Position.Z)
				local dist = delta.Magnitude
				if dist > 0.1 and dist <= DISTANCIA_MAXIMA then
					local dirAmigo = delta.Unit
					if lookPlano:Dot(dirAmigo) > 0.85 then
						amigoBloqueando = true
						break
					end
				end
			end
		end
	end

	if not amigoBloqueando then return end

	local inimigoAtrasOuPerto = acharMaisProximoGeral(meuRoot, DISTANCIA_MAXIMA)
	if not inimigoAtrasOuPerto then return end

	local dx = inimigoAtrasOuPerto.Position.X - meuRoot.Position.X
	local dz = inimigoAtrasOuPerto.Position.Z - meuRoot.Position.Z
	if (dx * dx + dz * dz) > 0.0025 then
		local yawDesejado = math.atan2(-dx, -dz)
		meuRoot.CFrame = CFrame.new(meuRoot.Position) * CFrame.fromEulerAnglesYXZ(0, yawDesejado, 0)
	end
end

-- ==========================================
-- SELECAO DO KILL AURA COM CACHE LEVE
-- ==========================================
local function atualizarCacheAlvos(agora, meuRoot, raioMax)
	if (agora - ultimoScanAlvosTick) < 0.04 then
		return
	end
	ultimoScanAlvosTick = agora
	table.clear(alvosElegiveisCache)

	local origemRef = (invisivelAtivo and posSuperficieInvisivel) or meuRoot.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if jogadorElegivelComoAlvo(plr) then
			local char = plr.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
				if hum and hum.Health > 0 and root and root.Parent then
					local d = (root.Position - origemRef).Magnitude
					if d <= (raioMax + MARGEM_PERSISTENCIA_KILL_AURA) and d > 0.1 then
						table.insert(alvosElegiveisCache, {
							plr = plr,
							root = root,
							hum = hum,
							dist = d
						})
					end
				end
			end
		end
	end
end

local function obterAlvoKillAuraPersistente(meuRoot, raioMax, agora)
	if not meuRoot then return nil, nil end

	if pvpFocusLoopAtivo then
		local rLoop, plrLoop, dentroDoAlcance = obterAlvoPvpLoopRegistrado(meuRoot)
		if rLoop and plrLoop and dentroDoAlcance then
			alvoKillAuraPlayer = plrLoop
			return rLoop, plrLoop
		end
		alvoKillAuraPlayer = nil
		return nil, nil
	end

	atualizarCacheAlvos(agora, meuRoot, raioMax)
	local origemRef = (invisivelAtivo and posSuperficieInvisivel) or meuRoot.Position

	if alvoKillAuraPlayer and alvoKillAuraPlayer.Parent == Players and jogadorElegivelComoAlvo(alvoKillAuraPlayer) then
		for _, item in ipairs(alvosElegiveisCache) do
			if item.plr == alvoKillAuraPlayer and item.root and item.root.Parent and item.hum.Health > 0 then
				local distAtual = (item.root.Position - origemRef).Magnitude
				if distAtual <= (raioMax + MARGEM_PERSISTENCIA_KILL_AURA) and distAtual > 0.1 then
					return item.root, alvoKillAuraPlayer
				end
			end
		end
		alvoKillAuraPlayer = nil
	end

	local melhorRoot = nil
	local melhorPlr = nil
	local melhorPontuacao = math.huge

	for _, item in ipairs(alvosElegiveisCache) do
		local d = (item.root.Position - origemRef).Magnitude
		if d <= raioMax and d > 0.1 then
			local bonusCaido = jogadorEstaCaidoKnockdown(item.hum) and -12 or 0
			local pontuacao = d + bonusCaido
			if pontuacao < melhorPontuacao then
				melhorPontuacao = pontuacao
				melhorRoot = item.root
				melhorPlr = item.plr
			end
		end
	end

	alvoKillAuraPlayer = melhorPlr
	return melhorRoot, melhorPlr
end

