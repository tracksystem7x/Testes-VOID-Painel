		setValorPorPosicaoX = function(px)
			local rel = math.clamp((px - tr.AbsolutePosition.X) / math.max(tr.AbsoluteSize.X, 1), 0, 1)
			setV(mn + rel * (mx - mn), true)
		end
	}
end

