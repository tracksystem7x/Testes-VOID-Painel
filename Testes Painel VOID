local function obterCachePartesPersonagem(char)
	if not char then return {} end
	if ultimoCacheChar == char and #partesPersonagemCache > 0 then
		return partesPersonagemCache
	end
	ultimoCacheChar = char
	table.clear(partesPersonagemCache)
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("Accessory")
			or desc:IsA("BasePart")
			or desc:IsA("Decal")
			or desc:IsA("Texture")
			or desc:IsA("SpecialMesh")
			or desc:IsA("Shirt")
			or desc:IsA("Pants")
			or desc:IsA("ShirtGraphic")
			or desc:IsA("CharacterMesh")
			or desc:IsA("BillboardGui") then
			table.insert(partesPersonagemCache, desc)
		end
	end
	return partesPersonagemCache
end

local function destruirAncoraCamera()
	if ancoraCameraInvisivel then
		pcall(function()
			ancoraCameraInvisivel:Destroy()
		end)
		ancoraCameraInvisivel = nil
	end
end

local function garantirAncoraCamera()
	if ancoraCameraInvisivel and ancoraCameraInvisivel.Parent then
		return ancoraCameraInvisivel
	end
	destruirAncoraCamera()
	local part = Instance.new("Part")
	part.Name = "VoidInvisCamAnchor"
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = workspace
	ancoraCameraInvisivel = part
	return part
end

local function limparSnapshotsInvisivel()
	table.clear(snapshotTransparenciaInvisivel)
	table.clear(snapshotPartTranspInvisivel)
	table.clear(snapshotTamanhoInvisivel)
	table.clear(snapshotCorMaterialInvisivel)
	table.clear(snapshotAcessoriosInvisivel)
	table.clear(snapshotDecalsInvisivel)
	table.clear(snapshotMeshesInvisivel)
	table.clear(snapshotRoupasInvisivel)
	table.clear(snapshotGuisInvisivel)
	snapshotDisplayDistHum = nil
	snapshotDisplayNameHum = nil
end

local function aplicarFioTotalInvisivel(char, hum, ativar, aplicarTamanhos)
	if not char then return end
	local itens = obterCachePartesPersonagem(char)

	if ativar then
		if hum then
			if snapshotDisplayDistHum == nil then
				pcall(function()
					snapshotDisplayDistHum = {
						NameDisplayDistance = hum.NameDisplayDistance,
						HealthDisplayDistance = hum.HealthDisplayDistance
					}
				end)
			end
			if snapshotDisplayNameHum == nil then
				pcall(function()
					snapshotDisplayNameHum = hum.DisplayName
				end)
			end
			pcall(function()
				hum.NameDisplayDistance = Enum.HumanoidDisplayDistanceType.None
				hum.HealthDisplayDistance = Enum.HumanoidDisplayDistanceType.None
				hum.DisplayName = ""
			end)
		end

		for _, desc in ipairs(itens) do
			if desc.Parent then
				if desc:IsA("Accessory") then
					if snapshotAcessoriosInvisivel[desc] == nil then
						snapshotAcessoriosInvisivel[desc] = desc.Parent
					end
					if desc.Parent ~= nil then
						pcall(function() desc.Parent = nil end)
					end
				elseif desc:IsA("BasePart") then
					if aplicarTamanhos then
						if snapshotTamanhoInvisivel[desc] == nil then
							snapshotTamanhoInvisivel[desc] = desc.Size
						end
						local alvoSize = (desc.Name == "HumanoidRootPart")
							and Vector3.new(0.002, 0.001, 0.002)
							or Vector3.new(0.001, 0.001, 0.001)
						if desc.Size ~= alvoSize then
							pcall(function() desc.Size = alvoSize end)
						end
					end
					if snapshotTransparenciaInvisivel[desc] == nil then
						snapshotTransparenciaInvisivel[desc] = desc.LocalTransparencyModifier
					end
					if snapshotPartTranspInvisivel[desc] == nil then
						snapshotPartTranspInvisivel[desc] = desc.Transparency
					end
					if snapshotCorMaterialInvisivel[desc] == nil then
						snapshotCorMaterialInvisivel[desc] = {
							Color = desc.Color,
							Material = desc.Material
						}
					end
					if desc.LocalTransparencyModifier ~= 1 or desc.Transparency ~= 1 or desc.CastShadow or desc.CanCollide then
						pcall(function()
							desc.Color = COR_PISO_QUADRA
							desc.Material = Enum.Material.SmoothPlastic
							desc.LocalTransparencyModifier = 1
							desc.Transparency = 1
							desc.CastShadow = false
							desc.CanCollide = false
						end)
					end
				elseif desc:IsA("SpecialMesh") then
					if snapshotMeshesInvisivel[desc] == nil then
						snapshotMeshesInvisivel[desc] = desc.Scale
					end
					if desc.Scale ~= Vector3.zero then
						pcall(function() desc.Scale = Vector3.zero end)
					end
				elseif desc:IsA("Decal") or desc:IsA("Texture") then
					if snapshotDecalsInvisivel[desc] == nil then
						snapshotDecalsInvisivel[desc] = desc.Transparency
					end
					if desc.Transparency ~= 1 then
						pcall(function() desc.Transparency = 1 end)
					end
				elseif desc:IsA("Shirt") or desc:IsA("Pants") then
					if snapshotRoupasInvisivel[desc] == nil then
						snapshotRoupasInvisivel[desc] = { tipo = "ShirtOrPants", template = desc.Parent }
					end
					if desc.Parent ~= nil then
						pcall(function() desc.Parent = nil end)
					end
				elseif desc:IsA("ShirtGraphic") then
					if snapshotRoupasInvisivel[desc] == nil then
						snapshotRoupasInvisivel[desc] = { tipo = "ShirtGraphic", template = desc.Parent }
					end
					if desc.Parent ~= nil then
						pcall(function() desc.Parent = nil end)
					end
				elseif desc:IsA("CharacterMesh") then
					if snapshotRoupasInvisivel[desc] == nil then
						snapshotRoupasInvisivel[desc] = { tipo = "CharacterMesh", template = desc.Parent }
					end
					if desc.Parent ~= nil then
						pcall(function() desc.Parent = nil end)
					end
				elseif desc:IsA("BillboardGui") then
					if snapshotGuisInvisivel[desc] == nil then
						snapshotGuisInvisivel[desc] = desc.Enabled
					end
					if desc.Enabled then
						pcall(function() desc.Enabled = false end)
					end
				end
			end
		end
	else
		for acc, parentOrig in pairs(snapshotAcessoriosInvisivel) do
			if acc and parentOrig and parentOrig.Parent then
				pcall(function()
					acc.Parent = parentOrig
				end)
			end
		end
		for part, origVal in pairs(snapshotTransparenciaInvisivel) do
			if part and part.Parent then
				pcall(function()
					part.LocalTransparencyModifier = origVal
				end)
			end
		end
		for part, origTransp in pairs(snapshotPartTranspInvisivel) do
			if part and part.Parent then
				pcall(function()
					part.Transparency = origTransp
				end)
			end
		end
		for part, origCM in pairs(snapshotCorMaterialInvisivel) do
			if part and part.Parent and origCM then
				pcall(function()
					part.Color = origCM.Color
					part.Material = origCM.Material
				end)
			end
		end
		for part, origSize in pairs(snapshotTamanhoInvisivel) do
			if part and part.Parent then
				pcall(function()
					part.Size = origSize
				end)
			end
		end
		for mesh, origScale in pairs(snapshotMeshesInvisivel) do
			if mesh and mesh.Parent then
				pcall(function()
					mesh.Scale = origScale
				end)
			end
		end
		for decal, origTransp in pairs(snapshotDecalsInvisivel) do
			if decal and decal.Parent then
				pcall(function()
					decal.Transparency = origTransp
				end)
			end
		end
		for inst, info in pairs(snapshotRoupasInvisivel) do
			if inst and info and info.template and info.template.Parent then
				pcall(function()
					inst.Parent = info.template
				end)
			end
		end
		for gui, origEnabled in pairs(snapshotGuisInvisivel) do
			if gui and gui.Parent then
				pcall(function()
					gui.Enabled = origEnabled
				end)
			end
		end

		limparSnapshotsInvisivel()

		if hum then
			pcall(function()
				if snapshotDisplayDistHum then
					hum.NameDisplayDistance = snapshotDisplayDistHum.NameDisplayDistance
					hum.HealthDisplayDistance = snapshotDisplayDistHum.HealthDisplayDistance
				end
				if snapshotDisplayNameHum ~= nil then
					hum.DisplayName = snapshotDisplayNameHum
				end
			end)
		end
	end
end

local function sincronizarCameraInvisivel(hum, posSuperficie)
	local cam = workspace.CurrentCamera
	if not cam then return end
	if invisivelAtivo and posSuperficie then
		local anc = garantirAncoraCamera()
		local cfAnc = CFrame.new(posSuperficie.X, posSuperficie.Y + 1.5, posSuperficie.Z)
		if anc.CFrame ~= cfAnc then
			anc.CFrame = cfAnc
		end
		if cam.CameraType ~= Enum.CameraType.Custom then
			cam.CameraType = Enum.CameraType.Custom
		end
		if cam.CameraSubject ~= anc then
			cam.CameraSubject = anc
		end
	else
		destruirAncoraCamera()
		if cam.CameraType == Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Custom
		end
		if hum and cam.CameraSubject ~= hum then
			cam.CameraSubject = hum
		end
	end
end

local function obterInputMovimentoPlano()
	local dir = Vector3.zero
	local cam = workspace.CurrentCamera
	if cam then
		local forward = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
		if forward.Magnitude > 0.001 then forward = forward.Unit else forward = Vector3.new(0, 0, -1) end
		if right.Magnitude > 0.001 then right = right.Unit else right = Vector3.new(1, 0, 0) end

		if not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
				dir += forward
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
				dir -= forward
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
				dir += right
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
				dir -= right
			end
		end
	end

	if dir.Magnitude <= 0.01 then
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local md = hum and hum.MoveDirection or Vector3.zero
		local plano = Vector3.new(md.X, 0, md.Z)
		if plano.Magnitude > 0.01 then
			dir = plano.Unit
		end
	end

	if dir.Magnitude > 0.01 then
		return dir.Unit
	end
	return Vector3.zero
end

local ultimoSyncTamanhoInvisivel = 0

local function atualizarInvisivelSubsolo(dt, agora)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)

	if not invisivelAtivo then
		sincronizarCameraInvisivel(hum, nil)
		return
	end

	if not char or not hum or hum.Health <= 0 or not root then
		sincronizarCameraInvisivel(hum, nil)
		return
	end

	if not posSuperficieInvisivel then
		posSuperficieInvisivel = root.Position
		local _, yawAtual, _ = root.CFrame:ToEulerAnglesYXZ()
		yawSuperficieInvisivel = yawAtual
	end

	local velHorizontal = WALKSPEED_BASE + (speedCFrameAtivo and math.min(24, math.max(0, speedCFrameValor - 1)) or 0)
	local passoPlano = obterInputMovimentoPlano()
	if passoPlano.Magnitude > 0.01 then
		local desloc = passoPlano * (velHorizontal * math.clamp(dt or 0.016, 0.001, 0.05))
		posSuperficieInvisivel = Vector3.new(
			posSuperficieInvisivel.X + desloc.X,
			posSuperficieInvisivel.Y,
			posSuperficieInvisivel.Z + desloc.Z
		)
		yawSuperficieInvisivel = math.atan2(-passoPlano.X, -passoPlano.Z)
	end

	local alturaLimiteVoid = workspace.FallenPartsDestroyHeight + 25
	local yAbaixo = math.max(posSuperficieInvisivel.Y - INVISIVEL_PROFUNDIDADE, alturaLimiteVoid)
	local cfFioDeitadoSubsolo = CFrame.new(posSuperficieInvisivel.X, yAbaixo, posSuperficieInvisivel.Z)
		* CFrame.fromEulerAnglesYXZ(0, yawSuperficieInvisivel, 0)
		* CFrame.Angles(math.rad(90), 0, 0)

	if hum.Sit then hum.Sit = false end
	if hum.PlatformStand then hum.PlatformStand = false end
	if root.CanCollide then root.CanCollide = false end
	if root.AssemblyLinearVelocity ~= Vector3.zero then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	if root.AssemblyAngularVelocity ~= Vector3.zero then
		root.AssemblyAngularVelocity = Vector3.zero
	end
	root.CFrame = cfFioDeitadoSubsolo

	local now = agora or os.clock()
	local aplicarTamanhos = (now - ultimoSyncTamanhoInvisivel) >= 0.35
	if aplicarTamanhos then
		ultimoSyncTamanhoInvisivel = now
	end
	aplicarFioTotalInvisivel(char, hum, true, aplicarTamanhos)
	sincronizarCameraInvisivel(hum, posSuperficieInvisivel)
end

local function setInvisivelEstado(novoEstado)
	invisivelAtivo = novoEstado
	ultimoCacheChar = nil
	ultimoSyncTamanhoInvisivel = 0
	ultimoDisparoKillAuraTick = 0
	ultimoDisparoAutoClickTick = 0
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)

	if not invisivelAtivo then
		destruirAncoraCamera()
		aplicarFioTotalInvisivel(char, hum, false, false)
		if root and posSuperficieInvisivel then
			local cfVolta = CFrame.new(posSuperficieInvisivel.X, posSuperficieInvisivel.Y + 1.2, posSuperficieInvisivel.Z)
				* CFrame.fromEulerAnglesYXZ(0, yawSuperficieInvisivel, 0)
			pcall(function()
				if hum then
					hum.Sit = false
					hum.PlatformStand = false
					hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
				root.CanCollide = true
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.CFrame = cfVolta
			end)
		end
		posSuperficieInvisivel = nil
		sincronizarCameraInvisivel(hum, nil)
	else
		if root then
			posSuperficieInvisivel = root.Position
			local _, yawAtual, _ = root.CFrame:ToEulerAnglesYXZ()
			yawSuperficieInvisivel = yawAtual
		end
		aplicarFioTotalInvisivel(char, hum, true, true)
		atualizarInvisivelSubsolo(0.016, os.clock())
	end
	garantirNomesEVidaOutrosJogadores(0)
end

