local PALAVRAS_FIGHT = { "fight", "pvp", "combat", "incombat", "battle", "brawl", "arena", "court", "quadra", "zone", "ragdoll", "safe" }

local function nomeEhFight(nome)
	if not nome or nome == "" then return false end
	local low = string.lower(nome)
	for _, p in ipairs(PALAVRAS_FIGHT) do
		if string.find(low, p, 1, true) then
			return true
		end
	end
	return false
end

local function liberarFerramentasECombate(char, hum)
	if hum then
		pcall(function()
			if hum.Sit then
				hum.Sit = false
			end
			if hum.PlatformStand then
				hum.PlatformStand = false
			end
			local st = hum:GetState()
			if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Physics then
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") and not item.Enabled then
				pcall(function()
					item.Enabled = true
				end)
			end
		end
	end
end

local function alternarEstadoFighting(ativar)
	fightingAtivo = ativar
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	local function ajustarContainer(container)
		if not container then return end
		for _, desc in ipairs(container:GetDescendants()) do
			local lowName = string.lower(desc.Name or "")
			if desc:IsA("BoolValue") and nomeEhFight(desc.Name) then
				local val = string.find(lowName, "safe", 1, true) and (not ativar) or ativar
				pcall(function() desc.Value = val end)
			elseif desc:IsA("StringValue") and nomeEhFight(desc.Name) then
				pcall(function() desc.Value = ativar and "Fighting" or "" end)
			elseif desc:IsA("NumberValue") or desc:IsA("IntValue") then
				if nomeEhFight(desc.Name) and not string.find(lowName, "safe", 1, true) then
					pcall(function() desc.Value = ativar and 1 or 0 end)
				end
			end
		end
	end

	ajustarContainer(LocalPlayer)
	ajustarContainer(char)
	liberarFerramentasECombate(char, hum)
end

local function garantirEstadoCombateParaAtaque(agora)
	local now = agora or os.clock()
	if (now - ultimoSyncCombateTick) < 0.35 then return end
	ultimoSyncCombateTick = now
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	liberarFerramentasECombate(char, hum)
end

-- ==========================================
-- OTIMIZACAO DE FPS
-- ==========================================
local function aplicarOtimizacaoFpsERede(ativar)
	boostFpsRedeAtivo = ativar

	if ativar then
		if not snapshotGraficoSalvo then
			snapshotGraficoSalvo = {
				GlobalShadows = Lighting.GlobalShadows
			}
		end

		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.EnvironmentSpecularScale = 0
			Lighting.EnvironmentDiffuseScale = 0
			for _, obj in ipairs(Lighting:GetChildren()) do
				if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
					obj.Enabled = false
				end
			end
		end)

		pcall(function()
			if settings and settings().Rendering then
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end
		end)

		pcall(function()
			local ws = workspace
			if ws.Terrain then
				ws.Terrain.Decoration = false
				ws.Terrain.WaterWaveSize = 0
				ws.Terrain.WaterWaveSpeed = 0
				ws.Terrain.WaterReflectance = 0
				ws.Terrain.WaterTransparency = 1
			end
			for _, desc in ipairs(ws:GetDescendants()) do
				if desc:IsA("ParticleEmitter") or desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Sparkles") then
					desc.Enabled = false
				elseif desc:IsA("Trail") or desc:IsA("Beam") then
					desc.Enabled = false
				elseif desc:IsA("Decal") or desc:IsA("Texture") then
					desc.Transparency = math.max(desc.Transparency, 0.85)
				elseif desc:IsA("BasePart") then
					desc.CastShadow = false
				end
			end
		end)

		pcall(function()
			if setfpscap then
				setfpscap(60)
			end
		end)
		pcall(function()
			if collectgarbage then
				collectgarbage("collect")
			end
		end)
	else
		if snapshotGraficoSalvo then
			pcall(function()
				Lighting.GlobalShadows = snapshotGraficoSalvo.GlobalShadows
				for _, obj in ipairs(Lighting:GetChildren()) do
					if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
						obj.Enabled = true
					end
				end
			end)
			pcall(function()
				if settings and settings().Rendering then
					settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
				end
			end)
		end
	end
end

